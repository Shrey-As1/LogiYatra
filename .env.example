# LogiYantra Environment Configuration Template
# Copy this file to .env and configure your values

# Flask Configuration
PORT=5000
FLASK_DEBUG=0

# TomTom Traffic and Routing Services
# Get an API key from https://developer.tomtom.com/
# Leave as placeholder if running in offline / OSM static network mode
TOMTOM_API_KEY=your_tomtom_api_key_here

# Map defaults (Center: Bhubaneswar, Odisha)
MAP_CENTER_LAT=20.2961
MAP_CENTER_LON=85.8245
MAP_RADIUS_METERS=12000
